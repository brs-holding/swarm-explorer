<main class="relative z-10 mx-auto max-w-[1240px] px-6 pb-24 pt-10 md:px-10 md:pt-14">

  <section class="mx-auto max-w-[760px] text-center">
    <h1 class="font-display font-bold text-[32px] md:text-[40px]" style="letter-spacing:-0.03em;">
      The hive, in the open.
    </h1>
    <p class="mt-3 mb-6 text-[15.5px]" style="color:var(--sw-mid);">
      Every block is public. What&rsquo;s inside stays yours unless you chose otherwise.
    </p>
    <form action="/search" class="sw-search">
      <label for="hero-search" class="sr-only">Search a block height, block hash, transaction id or transparent address</label>
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" stroke="#7d746a" stroke-width="1.8"/>
        <path d="M16 16l4 4" stroke="#7d746a" stroke-width="1.8" stroke-linecap="round"/>
      </svg>
      <input id="hero-search" name="qs" type="search"
             placeholder="Search block height, block hash, transaction id, or revealed address&hellip;">
      <button type="submit" class="sw-btn">Search</button>
    </form>
    <p class="mt-3 sw-mono text-[10.5px] tracking-[.14em]" style="color:var(--sw-low);">
      <%= if ZcashExplorer.Swarm.mainnet?() do %>
        <%= @network_name %>
      <% else %>
        <%= @network_name %> &middot; TEST COINS, NO VALUE
      <% end %>
    </p>
  </section>

  <%!-- Metric cards. Every figure is read from the node; a figure the node
        cannot supply shows an em dash rather than a placeholder. --%>
  <section class="mt-11 grid grid-cols-1 gap-3.5 sm:grid-cols-2 lg:grid-cols-4">
    <%= live_render(@conn, ZcashExplorerWeb.BlockCountLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.NetworkSolpsLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.SupplyLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.HalvingLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.DifficultyLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.MempoolInfoLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.PeersLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.BlockChainSizeLive) %>
  </section>

  <section class="mt-5">
    <%= live_render(@conn, ZcashExplorerWeb.ShieldedPoolLive) %>
  </section>

  <section class="mt-5 grid grid-cols-1 gap-4.5 lg:grid-cols-2" style="gap:18px;">
    <%= live_render(@conn, ZcashExplorerWeb.RecentBlocksLive) %>
    <%= live_render(@conn, ZcashExplorerWeb.RecentTransactionsLive) %>
  </section>

</main>
