<div class="grid gap-4 grid-cols-1 mx-8 py-5">

<div>
  <dl class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Block height</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.BlockCountLive) %></dd>
      <a href="/blocks" class="text-xs font-medium text-swarm-honey-ink dark:text-swarm-honey hover:underline">View blocks</a>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Difficulty</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.DifficultyLive) %></dd>
      <a href="/blockchain-info" class="text-xs font-medium text-swarm-honey-ink dark:text-swarm-honey hover:underline">Chain info</a>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Network solution rate (Sol/s)</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.NetworkSolpsLive) %></dd>
      <span class="text-xs text-gray-400">over the last 120 blocks</span>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Mempool transactions</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.MempoolInfoLive) %></dd>
      <a href="/mempool" class="text-xs font-medium text-swarm-honey-ink dark:text-swarm-honey hover:underline">View mempool</a>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Supply issued</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.SupplyLive) %></dd>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Next halving at height</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.HalvingLive) %></dd>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Value pools</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.ShieldedPoolLive) %></dd>
      <a href="/blockchain-info" class="text-xs font-medium text-swarm-honey-ink dark:text-swarm-honey hover:underline">All pools</a>
    </div>

    <div class="px-4 py-5 bg-white shadow rounded-lg overflow-hidden sm:p-6 dark:bg-swarm-wax">
      <dt class="text-sm font-medium text-gray-500 dark:text-gray-400 truncate">Chain size on disk</dt>
      <dd class="mt-1"><%= live_render(@conn, ZcashExplorerWeb.BlockChainSizeLive) %></dd>
    </div>
  </dl>
</div>

<div class="grid gap-4 grid-cols-1 md:grid-cols-1 mx-4 my-2">
    <div>
        <h3 class="text-lg leading-6 font-medium py-3 text-gray-900 dark:text-white">
        Latest blocks
        </h3>
        <%= live_render(@conn, ZcashExplorerWeb.RecentBlocksLive) %>
    </div>
</div>

<div>
    <h3 class="text-lg leading-6 font-medium text-gray-900 py-3 dark:text-white">
    Latest transactions
    </h3>
    <%= live_render(@conn, ZcashExplorerWeb.RecentTransactionsLive) %>
</div>

</div>
