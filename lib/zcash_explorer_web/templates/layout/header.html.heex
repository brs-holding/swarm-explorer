<header>
<nav x-data="{ open: false }" class="shrink-0 bg-swarm-bark dark:bg-swarm-hive border-b border-swarm-honey/10">
    <div class="max-w-7xl mx-auto px-2 sm:px-4 lg:px-8">
        <div class="relative flex items-center justify-between h-16">
            <!-- Logo section -->
            <div class="flex items-center px-2 lg:px-0 xl:w-64">
              <a href="/">
                <div class="shrink-0">
                    <img class="h-8 w-auto" src={"#{Routes.static_path(@conn, "/images/swarm-mark.svg")}"} alt={"#{@project_name} block explorer"}>
                </div>
              </a>
              <a href="/">
                <div class="shrink-0 px-3 text-swarm-honey font-semibold tracking-wide text-sm md:block hidden">
                  <%= @project_name %> Explorer
                  <span class="text-white/40 font-normal"><%= @network_name %></span>
                </div>
              </a>
            </div>
            <!-- Search section -->
            <div class="flex-1 flex justify-center lg:justify-end">
                <div class="w-full px-2 lg:px-6">
                    <label for="search" class="sr-only">transaction / block / address</label>
                    <div class="relative text-white/60 focus-within:text-white">
                        <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                    <form action="/search">
                        <input id="search" name="qs"
                          class="block w-full pl-10 pr-3 py-2 border border-white/10 rounded-md leading-5
                                 bg-white/10 placeholder-white/40 text-white text-sm
                                 focus:outline-none focus:bg-white/20 focus:border-swarm-honey/60
                                 focus:ring-1 focus:ring-swarm-honey/60 focus:placeholder-white/60"
                          placeholder="height / block / transaction / address" type="search">
                    </form>
                    </div>
                </div>
            </div>
            <div class="flex lg:hidden">
                <!-- Mobile menu button -->
                <button type="button"
                  class="bg-transparent inline-flex items-center justify-center p-2 rounded-md text-white/60 hover:text-swarm-honey focus:outline-none focus:ring-2 focus:ring-swarm-honey/50"
                  aria-controls="mobile-menu" @click="open = !open" aria-expanded="true" x-bind:aria-expanded="open.toString()">
                    <span class="sr-only">Open main menu</span>
                    <svg class="h-6 w-6 hidden" :class="{ 'hidden': open, 'block': !(open) }" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h8m-8 6h16"></path>
                    </svg>
                    <svg class="h-6 w-6 block" :class="{ 'block': open, 'hidden': !(open) }" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
                    </svg>
                </button>
            </div>
            <!-- Links section -->
            <div class="hidden lg:block lg:w-80 z-40">
                <div class="flex items-center justify-end">
                    <div class="flex">
                      <a href="/blocks"          class="px-3 py-2 rounded-md text-sm font-medium tracking-wide text-white/70 hover:text-swarm-honey transition-colors">Blocks</a>
                      <a href="/mempool"         class="px-3 py-2 rounded-md text-sm font-medium tracking-wide text-white/70 hover:text-swarm-honey transition-colors">Mempool</a>
                      <a href="/nodes"           class="px-3 py-2 rounded-md text-sm font-medium tracking-wide text-white/70 hover:text-swarm-honey transition-colors">Nodes</a>
                      <a href="/blockchain-info" class="px-3 py-2 rounded-md text-sm font-medium tracking-wide text-white/70 hover:text-swarm-honey transition-colors">Chain</a>
                      <a href="/broadcast"       class="px-3 py-2 rounded-md text-sm font-medium tracking-wide text-white/70 hover:text-swarm-honey transition-colors">Broadcast</a>
                    </div>
                </div>
            </div>

            <button id="theme-toggle" type="button"
              class="text-white/50 hover:text-swarm-honey focus:outline-none focus:ring-2 focus:ring-swarm-honey/50 rounded-lg text-sm p-2.5 transition-colors ml-1">
                <span class="sr-only">Toggle light and dark theme</span>
                <svg id="theme-toggle-dark-icon"  class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path></svg>
                <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path></svg>
            </button>
        </div>
    </div>
    <!-- Mobile menu -->
    <div class="lg:hidden" id="mobile-menu" x-show="open">
        <div class="px-2 pt-2 pb-3 border-t border-swarm-honey/10">
            <a href="/blocks"          class="block px-3 py-2 rounded-md text-base font-medium text-white/70 hover:text-swarm-honey hover:bg-white/5 transition-colors">Blocks</a>
            <a href="/mempool"         class="block px-3 py-2 rounded-md text-base font-medium text-white/70 hover:text-swarm-honey hover:bg-white/5 transition-colors">Mempool</a>
            <a href="/nodes"           class="block px-3 py-2 rounded-md text-base font-medium text-white/70 hover:text-swarm-honey hover:bg-white/5 transition-colors">Nodes</a>
            <a href="/blockchain-info" class="block px-3 py-2 rounded-md text-base font-medium text-white/70 hover:text-swarm-honey hover:bg-white/5 transition-colors">Chain</a>
            <a href="/broadcast"       class="block px-3 py-2 rounded-md text-base font-medium text-white/70 hover:text-swarm-honey hover:bg-white/5 transition-colors">Broadcast</a>
        </div>
    </div>
</nav>
</header>
