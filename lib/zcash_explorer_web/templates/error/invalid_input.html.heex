<%!-- The page a search lands on when nothing matches, and the page the address
      route renders when the node does not know an address. It replaced a bare
      "Invalid input" string, and it is what a visitor now sees instead of the
      HTTP 500 that searching a transparent address used to produce. --%>
<main class="relative z-10 mx-auto max-w-[760px] px-6 pb-24 pt-14 md:px-10">

  <div class="sw-card px-6 py-7">
    <p class="sw-key">NOTHING FOUND</p>

    <h1 class="mt-2 font-display font-bold text-[26px] md:text-[30px]" style="letter-spacing:-0.02em;">
      That does not look like anything on this chain.
    </h1>

    <%= if @query != "" do %>
      <p class="mt-4 text-[14.5px]" style="color:var(--sw-mid);">
        Searched for
        <span class="sw-mono break-all" style="color:var(--sw-text);"><%= @query %></span>
      </p>
    <% end %>

    <p class="mt-4 text-[14.5px]" style="color:var(--sw-mid);">
      The search box takes any of these:
    </p>

    <ul class="mt-3 space-y-2 text-[14px]" style="color:var(--sw-mid);">
      <li><span class="sw-mono" style="color:var(--sw-text);">12345</span> &mdash; a block height</li>
      <li><span class="sw-mono" style="color:var(--sw-text);">64 hex characters</span> &mdash; a block hash or a transaction id</li>
      <li><span class="sw-mono" style="color:var(--sw-text);">tm&hellip;</span> or <span class="sw-mono" style="color:var(--sw-text);">t2&hellip;</span> &mdash; a revealed (transparent) address</li>
      <li><span class="sw-mono" style="color:var(--sw-text);">ztestsapling1&hellip;</span> or <span class="sw-mono" style="color:var(--sw-text);">utest1&hellip;</span> &mdash; a shielded or unified address</li>
    </ul>

    <p class="mt-4 text-[13.5px]" style="color:var(--sw-low);">
      A block or a transaction this node has not seen yet will not be found
      here either.<%= unless ZcashExplorer.Swarm.mainnet?() do %>
        <%= assigns[:network_name] || "This network" %> is a test
        network and its history can be replaced.<% end %>
    </p>

    <form action="/search" class="sw-search mt-6">
      <label for="notfound-search" class="sr-only">Search again</label>
      <input id="notfound-search" name="qs" type="search" placeholder="height / hash / address">
      <button type="submit" class="sw-btn">Search</button>
    </form>

    <p class="mt-6">
      <a href="/" class="text-[14px]">Back to the front page</a>
    </p>
  </div>

</main>
