# SWARM explorer — example environment.
# Every variable is documented in README-SWARM.md. Copy, fill in, keep out of git.

# --- Web -------------------------------------------------------------------
# At least 64 bytes: openssl rand -base64 48   (or mix phx.gen.secret)
export SECRET_KEY_BASE=CHANGE_ME
# Two more Phoenix secrets, each generated separately with
#   openssl rand -base64 48
# They used to be literals in the source and were frozen into the image;
# the container refuses to start if either is missing.
export SESSION_SIGNING_SALT=CHANGE_ME
export LIVE_VIEW_SIGNING_SALT=CHANGE_ME
export EXPLORER_HOSTNAME=explore.swarm.green
export EXPLORER_SCHEME=https
export EXPLORER_PORT=443
export PORT=4000
export LOG_LEVEL=info

# --- Zebra node ------------------------------------------------------------
export ZEBRA_RPC_URL=http://zebra:18232
# Zebra writes a NEW secret into this file on every start. It is read per
# request and re-read after an auth failure; never copy its contents anywhere.
export ZEBRA_COOKIE_PATH=/zebra-cookie/.cookie
# Only for a node running with enable_cookie_auth = false:
# export ZEBRA_RPC_USER=
# export ZEBRA_RPC_PASSWORD=

# --- Network identity ------------------------------------------------------
export SWARM_PROJECT_NAME=SWARM
export SWARM_NETWORK_NAME=SwarmTestnet
export SWARM_TICKER=SWM
export SWARM_MAX_SUPPLY=20999987.3152
export SWARM_HALVING_INTERVAL=1680000
export SWARM_BLOCK_TARGET_SECONDS=75

# --- Block reward destinations ---------------------------------------------
# `slot` is the upstream Zebra receiver name from the node's funding_streams
# TOML; `label` is what this explorer shows instead.
export SWARM_RECIPIENTS_FILE=/etc/swarm/recipients.json
# ...or inline:
# export SWARM_RECIPIENTS='[{"slot":"ECC","label":"Core Development","address":"t2...","percent":8},{"slot":"MajorGrants","label":"Grants & Ecosystem","address":"t2...","percent":4},{"slot":"ZcashFoundation","label":"Community & Development Reserve","address":"t2...","percent":8}]'

# --- Resource limits (2 vCPU / 4 GB server) --------------------------------
export SWARM_CACHE_LIMIT=1500
export SWARM_CACHE_TTL_MINUTES=15
export SWARM_WARMER_WINDOW=21
export SWARM_WARMER_INTERVAL_MS=25000
